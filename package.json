{
  "name": "hypertrophy-engine",
  "version": "1.0.0",
  "description": "API designed to generate, track and adapt weekly trining plans based on user profiles",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "fitness",
    "training",
    "hypertrophy",
    "api",
    "workout"
  ],
  "author": "Josue Cruz",
  "license": "ISC",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.12.4"
  },
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/express": "^5.0.3",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
